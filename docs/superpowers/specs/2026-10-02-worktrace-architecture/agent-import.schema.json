{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "skill_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tool",
        "skill",
        "skill_version"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "generated_at",
    "producer",
    "items"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worktrace:agent-import:v1",
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "reference"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "task",
            "project_note",
            "fact",
            "decision",
            "outcome"
          ]
        },
        "content": {
          "type": "object"
        },
        "sources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "required": [
        "item_id",
        "kind",
        "content",
        "sources"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "task"
            },
            "content": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "completion_criteria": {
                  "type": "string"
                }
              },
              "required": [
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "project_note"
            },
            "content": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "title",
                "body"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "fact"
            },
            "content": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "key",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "decision"
            },
            "content": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "decided_at": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/timestamp"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "title",
                "rationale",
                "decided_at"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "outcome"
            },
            "content": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "occurred_at": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/timestamp"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "title",
                "body",
                "occurred_at"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    }
  }
}
